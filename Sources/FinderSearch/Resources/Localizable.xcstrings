        }
      }
    },
    "Encrypted or incomplete ZIP archives cannot be extracted.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法解压加密或不完整的 ZIP 压缩包。"
