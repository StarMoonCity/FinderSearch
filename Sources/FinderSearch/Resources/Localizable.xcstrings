        }
      }
    },
    "The archive contains an unsafe file path.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此压缩包包含不安全的文件路径。"
          }
        }
      }
    },
    "Archives containing symbolic links or special files cannot be extracted.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法解压包含符号链接或特殊文件的压缩包。"
